# Copy to .env and fill in. Never commit a file with real values.
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build time, so
# treat every one of them as public. Nothing secret belongs here — the Firebase
# web keys below identify the project and are protected by Firestore security
# rules, exactly as they are in the web app's browser bundle.

# ── Backend ──────────────────────────────────────────────────────────────────
# The deployed web app, whose /api/content and /api/spotify/* routes this app
# reuses. Point it at a local dev server to test against one.
EXPO_PUBLIC_SITE_URL=https://messageinabottle.sbs

# ── Firebase ─────────────────────────────────────────────────────────────────
# Same project as the web app — copy these from the root .env, renaming the
# NEXT_PUBLIC_ prefix to EXPO_PUBLIC_.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web OAuth client id from Firebase Auth → Sign-in method → Google.
# Google Sign-In additionally needs google-services.json (Android) and a SHA-1
# fingerprint registered in the Firebase console — see mobile/README.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── AdMob ────────────────────────────────────────────────────────────────────
# Application ids, consumed by app.config.ts at build time. Leave unset to build
# against Google's published sample ids, which serve test ads.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Ad unit ids. An unset unit renders nothing at all — no container, no
# placeholder. Debug builds always request Google's test units regardless.
EXPO_PUBLIC_ADMOB_UNIT_BROWSE=
EXPO_PUBLIC_ADMOB_UNIT_MESSAGE=

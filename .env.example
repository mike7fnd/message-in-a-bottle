# Copy to .env.local and fill in. Never commit a file containing real values.
#
# NOTE: the repository's .env file is currently tracked by git and contains
# live secrets. See ADSENSE-READINESS.md ("Owner action required") for the
# rotation steps — removing the file now does not remove it from git history.

# ── Firebase (public by design; these ship to the browser) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth web client id (Firebase Auth → Settings → Web SDK configuration)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Secrets (server-only — must never be prefixed NEXT_PUBLIC_) ──────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ip-api.com key for the country/city lookup in /api/track-visit.
# Leave empty to switch off geo visit analytics.
IPAPI_KEY=

# ── Site / compliance configuration ──────────────────────────────────────────
# Canonical origin, no trailing slash. Defaults to https://messageinabottle.sbs
NEXT_PUBLIC_SITE_URL=

# AdSense publisher id, format ca-pub-0000000000000000.
# Defaults to the site's existing published id. Set to "none" on preview and
# staging deployments so ad code and the verification meta tag are omitted.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Ad unit slot ids from the AdSense dashboard. Any slot left empty renders
# nothing at all — no container, no placeholder.
NEXT_PUBLIC_ADSENSE_SLOT_BROWSE_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_MESSAGE_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_FOOTER=

# Public contact address shown on /contact and in the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Person or entity operating the site, shown in the footer and legal pages.
NEXT_PUBLIC_SITE_OPERATOR=

# ── Subscriptions (PayPal) ───────────────────────────────────────────────────
# All server-only. Never prefix any of these NEXT_PUBLIC_.
# With any of them unset, /api/billing/create-subscription returns 503 and the
# upgrade button reports that subscriptions are unavailable — it never
# pretends to have taken a payment.

# 'sandbox' (default) or 'live'
PAYPAL_ENV=sandbox
# From PayPal Developer → Apps & Credentials → your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The billing plan the Subscribe button uses (Products → Plans)
PAYPAL_PLAN_ID=
# From the webhook you register at /api/paypal/webhook. Without it, every
# webhook is rejected — this is what stops anyone POSTing themselves access.
PAYPAL_WEBHOOK_ID=

# Firebase service-account JSON, whole file on one line. Lets the server verify
# ID tokens and write subscribers/{uid}, which clients cannot write.
FIREBASE_SERVICE_ACCOUNT=
